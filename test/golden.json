          },
          "body": "{\"models\": [{\"type\": \"llm\", \"publisher\": \"qwen\", \"key\": \"qwen/qwen3-8b\", \"loaded_instances\": [{\"id\": \"qwen/qwen3-8b\"}]}, {\"type\": \"llm\", \"publisher\": \"openai\", \"key\": \"openai/gpt-oss-20b\", \"loaded_instances\": []}, {\"type\": \"embedding\", \"publisher\": \"nomic-ai\", \"key\": \"text-embedding-nomic-embed-text-v1.5\", \"loaded_instances\": []}]}"
        }
      ],
      "expected": {
        "body": {
          "object": "list",
          "data": [
            {
              "id": "qwen/qwen3-8b",
              "object": "model",
              "owned_by": "qwen"
            },
            {
              "id": "openai/gpt-oss-20b",
              "object": "model",
              "owned_by": "openai"
            }
          ]
        }
      }
    },
    {
      "name": "v1 list, embedding models only",
      "hook": "convertResponse",
      "args": [
        {
          "baseUrl": "http://127.0.0.1:1234",
          "path": "/v1/models",
          "config": {
            "modelTypes": "embedding"
          }
        },
        {
          "status": 200,
          "headers": {
            "Content-Type": "application/json"
          },
          "body": "{\"models\": [{\"type\": \"llm\", \"publisher\": \"qwen\", \"key\": \"qwen/qwen3-8b\", \"loaded_instances\": [{\"id\": \"qwen/qwen3-8b\"}]}, {\"type\": \"llm\", \"publisher\": \"openai\", \"key\": \"openai/gpt-oss-20b\", \"loaded_instances\": []}, {\"type\": \"embedding\", \"publisher\": \"nomic-ai\", \"key\": \"text-embedding-nomic-embed-text-v1.5\", \"loaded_instances\": []}]}"
        }
      ],
      "expected": {
        "body": {
